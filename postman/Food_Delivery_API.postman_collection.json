              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"{{unique_email}}\",\n  \"password\": \"TestPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('unique_email','postman.'+Date.now()+'@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Registration returns 201\",()=>pm.response.to.have.status(201)); const d=pm.response.json(); if(d.token)pm.collectionVariables.set(\"token\",d.token);if(d.user?.id)pm.collectionVariables.set(\"user_id\",d.user.id);"
                ]
              }
            }
          ]
